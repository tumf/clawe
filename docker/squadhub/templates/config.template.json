{
  "env": {
    "CONVEX_URL": "${CONVEX_URL}"
  },
  "models": {
    "providers": {
      "anthropic": {
        "apiKey": "${ANTHROPIC_API_KEY}"
      },
      "zai": {
        "baseUrl": "https://api.z.ai/api/paas/v4",
        "apiKey": "${ZAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-5",
            "name": "GLM-5",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/data/workspace",
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      },
      "model": {
        "primary": "${CLAWE_MODEL}"
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "name": "Clawe",
        "workspace": "/data/workspace",
        "identity": {
          "name": "Clawe",
          "emoji": "🦞"
        }
      },
      {
        "id": "inky",
        "name": "Inky",
        "workspace": "/data/workspace-inky",
        "model": "${CLAWE_MODEL}",
        "identity": {
          "name": "Inky",
          "emoji": "✍️"
        }
      },
      {
        "id": "pixel",
        "name": "Pixel",
        "workspace": "/data/workspace-pixel",
        "model": "${CLAWE_MODEL}",
        "identity": {
          "name": "Pixel",
          "emoji": "🎨"
        }
      },
      {
        "id": "scout",
        "name": "Scout",
        "workspace": "/data/workspace-scout",
        "model": "${CLAWE_MODEL}",
        "identity": {
          "name": "Scout",
          "emoji": "🔍"
        }
      }
    ]
  },
  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "main",
        "inky",
        "pixel",
        "scout"
      ]
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
  "gateway": {
    "port": ${OPENCLAW_PORT},
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_TOKEN}"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  }
}
